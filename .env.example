# Copy to .env and fill in. Never commit the real .env file.

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- BigQuery ---
# Auth via `gcloud auth application-default login` against a principal with
# read access to this project - same auth already used for sql/.
GCP_PROJECT=ops-intel-logistics
BQ_MARTS_DATASET=marts

# --- Neo4j ---
# Same instance/database already seeded for neo4j/ (see neo4j/README.md).
NEO4J_URI=neo4j+s://<your-db-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=opsintel-supply-network

# --- Vector store ---
CHROMA_PERSIST_DIR=agent/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Tracing (LangSmith) ---
# Optional but recommended - free tier at https://smith.langchain.com.
# No code changes needed: LangChain/LangGraph auto-detect these env vars.
# Leave LANGCHAIN_TRACING_V2 unset/false to run with tracing off.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ops-intel-agent
